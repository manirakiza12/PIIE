# =============================================================================
# PIIE production environment — MAIL / network section
# =============================================================================
#
# Copy the values you need into the administrator-owned
# /home/piie/deployments/piie/shared/.env. Never commit that file: it contains
# APP_KEY, database passwords and SMTP credentials.
#
# The application first applies platform SMTP settings from the
# `global_settings` table (smtp_host, smtp_port, smtp_user, smtp_pass,
# smtp_crypto). If those rows are populated they override the MAIL_* values
# below. Keep the two in step; see docs/phase0/SMTP-NETWORK-CONTRACT.md.
#
# MAIL_HOST=postfix is the Docker DNS alias of Mailcow's postfix container on
# the external mailcowdockerized_mailcow-network. Port 25 is the internal,
# unauthenticated relay port used between containers on that private network.
# Do not put a public hostname or a temporary container IP here.
# =============================================================================

MAIL_MAILER=smtp
MAIL_HOST=postfix
MAIL_PORT=25
MAIL_ENCRYPTION=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@piie.ac.ug
MAIL_FROM_NAME="Prime International Institute of Excellence"

# Compose reads these four names (see compose.production.yaml). Values are
# intentionally blank here; they belong only in the untracked production .env.
PIIE_DB_NAME=
PIIE_DB_USER=
PIIE_DB_PASSWORD=
PIIE_DB_ROOT_PASSWORD=
