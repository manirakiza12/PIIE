APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# true in production over HTTPS (session cookie sent only on secure connections);
# leave empty/false for local http:// development.
SESSION_SECURE_COOKIE=

# Development-only. Honoured ONLY when APP_ENV=local AND the default connection is
# MySQL/MariaDB on a loopback host at port 3307 (verified live via @@port).
# Fails closed everywhere else. Keep false; never enable in production.
BYPASS_SUBSCRIPTION=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Live Class API Integrations
# Zoom Server-to-Server OAuth credentials
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Google Meet via Google Calendar API OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Jitsi moderator JWT (see LIVE_CLASS_JITSI_JWT_SETUP.md). Leave blank to
# keep the anonymous Jitsi embed, where nobody is recognised as moderator.
# RS256 = 8x8 JaaS (app_id + kid + private_key); HS256 = self-hosted Jitsi
# with the jitsi-meet-tokens plugin (app_id + app_secret).
JITSI_JWT_ALGORITHM=RS256
JITSI_APP_ID=
JITSI_KID=
JITSI_PRIVATE_KEY=
JITSI_APP_SECRET=
