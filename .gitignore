.env
.env.*.php
.env.*.json
.env.*.yml
.phpunit.result.cache
/index.php

# Laravel logs and cache
/storage/*.key
/storage/app/public/*
!/storage/app/public/.gitignore

# Google OAuth client credentials.
#
# storage/app is the writable disk root and is NOT covered by any rule above, so
# without this the OAuth JSON is trackable and a routine `git add -A` would
# commit a client secret. Verified with `git status --porcelain` before this rule
# existed, which reported `?? storage/app/google/` — i.e. untracked, not ignored.
#
# The directory, not just the filename, so a rotated or differently-named
# credentials file is also ignored. There is no reason to ever commit anything
# in here.
/storage/app/google/
/storage/debugbar
/storage/framework/cache/data
/storage/framework/sessions
/storage/framework/testing
/storage/framework/views
/storage/logs
/storage/oauth-private.key
/storage/oauth-public.key
/storage/*.log

